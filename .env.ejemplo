# Copia este archivo como ".env" y completa tus propios valores.
# El archivo .env NO se sube al repositorio; este ejemplo sí.
# En Vercel, estas mismas variables se configuran en Settings > Environment Variables.

# Clave para firmar la sesión (inventa una larga y difícil de adivinar)
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria

# Cuenta de administrador
ADMIN_CORREO=
ADMIN_CLAVE=

# Cuenta de usuario normal
USUARIO_CORREO=
USUARIO_CLAVE=
